ENV=development
# Local BE Docker: http://localhost:8001 (see docs/hybrid-local-dev.md)
# Production: https://YOUR-API-HOST (see docs/PRODUCTION.md)
API_BASE_URL=http://localhost:8001
API_PREFIX=/api/v1
RAZORPAY_KEY_ID=
# Optional storage bucket name (API serves files at /media/{bucket}/...)
STORAGE_BUCKET=verification-documents
# Legacy only — not required when backend uses DATABASE_URL + local media
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_STORAGE_BUCKET=verification-documents
